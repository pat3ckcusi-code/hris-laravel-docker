APP_NAME=HRIS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hris.lgucalapan.ph
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
# Production: use "stderr" so Docker captures logs via `docker logs`.
# Shared hosting / file-based: use "daily" to rotate logs automatically.
LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ── Database ──────────────────────────────────────────────────────────────────
# Docker (default): DB_HOST=db (internal Docker network service name)
# Komodo Web / external MySQL: DB_HOST=<your-db-hostname-or-ip>
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hris
DB_USERNAME=laravel_user
DB_PASSWORD=CHANGE_ME
# Required by compose.dev.yaml for the MySQL container root account
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ── Sessions ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving over HTTPS (required in production)
SESSION_SECURE_COOKIE=true

# ── Queue / Cache ─────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ──────────────────────────────────────────────────────────────────────
# Change MAIL_MAILER from "log" (dev) to "smtp" (production).
MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=mail.lgucalapan.ph
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@lgucalapan.ph"
MAIL_FROM_NAME="City Human Resource Department"

# ── Biometric time-log integration API ───────────────────────────────────────
INTEGRATION_API_BASE_URL=
INTEGRATION_API_USERNAME=
INTEGRATION_API_PASSWORD=
INTEGRATION_API_TOKEN_PATH=/api/Integration/GetToken
INTEGRATION_API_LOGS_PATH=/api/Integration/GetTimeLogsBulkData
INTEGRATION_API_TOKEN_TIMEOUT=15
INTEGRATION_API_LOGS_TIMEOUT=30
INTEGRATION_API_LOGS_PAGE_SIZE=1000

# ── DTR / attendance Excel export ─────────────────────────────────────────────
EXCEL_EXPORT_SHEET_PASSWORD=CHANGE_ME
EXCEL_EXPORT_PROTECTION_ENABLED=true
